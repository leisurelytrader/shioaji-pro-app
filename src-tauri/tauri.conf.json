{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shioaji Private Market",
  "version": "0.1.0",
  "identifier": "tw.shioaji.private-market",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shioaji Private Market",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/collector"],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "startMenuFolder": "Shioaji Private Market",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
