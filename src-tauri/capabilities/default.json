{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for the Shioaji Private Market app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:21322/**" },
        { "url": "http://localhost:21322/**" },
        { "url": "http://127.0.0.1:8787/**" },
        { "url": "http://localhost:8787/**" }
      ]
    },
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/collector",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/collector",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "dialog:default",
    "store:default"
  ]
}
