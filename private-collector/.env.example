# Shioaji Pro server that already owns the broker login/session.
SHIOAJI_BASE_URL=http://127.0.0.1:8000
# SQLite database file. Parent directories are created automatically.
DATABASE_URL=./data/shioaji-market.sqlite
# HTTP bind address for the private history API.
COLLECTOR_HOST=127.0.0.1
COLLECTOR_PORT=8787
# Comma-separated symbols. Use security type/exchange when needed below.
COLLECTOR_SYMBOLS=TXFR1
# Optional JSON subscription overrides. Defaults to FUT/TXF/TXFR1.
COLLECTOR_CONTRACTS_JSON=[{"security_type":"FUT","exchange":"TAIFEX","code":"TXFR1","target_code":null,"intraday_odd":false}]
BATCH_SIZE=500
FLUSH_INTERVAL_MS=1000
RECONNECT_MIN_MS=1000
RECONNECT_MAX_MS=15000
